# =============================================================
# GYMatrix Backend — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# =============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────────
# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/gymatrix
# Docker example:
# DATABASE_URL=postgresql://gymatrix:gymatrix@localhost:5432/gymatrix
# Supabase/Neon/Railway: paste the full connection string from dashboard

# ── JWT Secrets (generate with: openssl rand -hex 64) ───────
JWT_ACCESS_SECRET=change_me_access_secret_min_64_chars_long_please_generate_with_openssl
JWT_REFRESH_SECRET=change_me_refresh_secret_min_64_chars_long_different_from_access

# ── JWT Expiry ───────────────────────────────────────────────
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── File Uploads & S3 (Garage) ─────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=garage_key
S3_SECRET_KEY=garage_secret
S3_BUCKET_NAME=gymatrix-image

# ── Password Reset ───────────────────────────────────────────
# How long password reset tokens stay valid (in minutes)
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=60

# ── Brute Force Protection ───────────────────────────────────
# Number of failed login attempts before account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
# Lockout duration in minutes
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# ── Logging ──────────────────────────────────────────────────
# development | production
LOG_LEVEL=debug

# ── App Config ───────────────────────────────────────────────
APP_NAME=GYMatrix
API_PREFIX=/api/v1

# Public backend origin used in invoice view links (no trailing slash)
PUBLIC_API_URL=http://localhost:3001

# Evolution Go text messaging. Set only the base URL; the backend appends /send/text.
# The instance token is sent in the `apikey` request header.
EVOLUTION_GO_ENABLED=false
EVOLUTION_GO_URL=http://overfit-pro-v1-evolutiongo-ihcnh6-31835a-94-136-190-40.sslip.io
# EVOLUTION_GO_INSTANCE_TOKEN=
EVOLUTION_GO_DEFAULT_COUNTRY_CODE=91
EVOLUTION_GO_TIMEOUT_MS=10000

# Background jobs use bounded batches and staggered, non-overlapping runs.
# These are intervals, not a clock time, so no job is scheduled specifically at midnight.
MEMBERSHIP_EXPIRY_SWEEP_INTERVAL_MS=300000
MEMBERSHIP_EXPIRY_BATCH_SIZE=200
INACTIVE_MEMBER_SWEEP_INTERVAL_MS=3600000
INACTIVE_MEMBER_SWEEP_BATCH_SIZE=200
BIOMETRIC_SYNC_WORKER_INTERVAL_MS=30000
BIOMETRIC_COMMAND_MAX_ATTEMPTS=6
BIOMETRIC_COMMAND_CLEANUP_BATCH_SIZE=500
BIOMETRIC_DEVICE_OFFLINE_AFTER_MS=600000
ATTENDANCE_AUTO_CHECKOUT_SWEEP_INTERVAL_MS=60000
ATTENDANCE_AUTO_CHECKOUT_BATCH_SIZE=200
SCHEDULER_STARTUP_JITTER_MS=30000
